// Kortech Sierra Leone — database schema.
// Milestone 1 holds reference data only; later milestones add their models here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Reference data (Milestone 1) ----------

model District {
  id               String            @id @default(cuid())
  name             String            @unique
  slug             String            @unique
  province         String
  // Forecast point: the district headquarter town (see prisma/data/districts.ts).
  latitude         Float
  longitude        Float
  chiefdoms        Chiefdom[]
  farmerProfiles   FarmerProfile[]
  organisations    Organisation[]
  supplierListings SupplierListing[]
  weatherCache     WeatherCache?
}

model Chiefdom {
  id             String          @id @default(cuid())
  name           String
  districtId     String
  district       District        @relation(fields: [districtId], references: [id], onDelete: Cascade)
  farmerProfiles FarmerProfile[]

  @@unique([districtId, name])
  @@index([districtId])
}

model Crop {
  id         String          @id @default(cuid())
  name       String          @unique
  slug       String          @unique
  // Groups crops for display, e.g. vegetables (pepper, okra, tomato).
  group      String
  isPriority Boolean         @default(false)
  farmers    FarmerProfile[]
  guides     CropGuide[]
}

// ---------- Accounts and auth (Milestone 2) ----------

enum Role {
  FARMER
  SUPPLIER
  BUYER
  LENDER
  ADMIN
  AGRONOMIST
}

enum FarmSizeUnit {
  ACRE
  HECTARE
}

model User {
  id              String           @id @default(cuid())
  // E.164, e.g. +23276123456
  phone           String           @unique
  name            String?
  role            Role             @default(FARMER)
  language        String           @default("en")
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
  farmerProfile   FarmerProfile?
  sessions        Session[]
  memberships     OrgMember[]
  verifiedOrgs    Organisation[]   @relation("VerifiedBy")
  auditLogs       AuditLog[]
  reviewedGuides  CropGuide[]      @relation("GuideReviewedBy")
  editedGuides    CropGuide[]      @relation("GuideUpdatedBy")
  aiConversations AiConversation[]
  reviewedAnswers AiMessage[]      @relation("AiReviewedBy")
}

model FarmerProfile {
  userId       String       @id
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  districtId   String
  district     District     @relation(fields: [districtId], references: [id])
  chiefdomId   String?
  chiefdom     Chiefdom?    @relation(fields: [chiefdomId], references: [id])
  farmSize     Decimal?     @db.Decimal(10, 2)
  farmSizeUnit FarmSizeUnit @default(ACRE)
  crops        Crop[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([districtId])
}

// One-time sign-in codes. Only an HMAC of the code is stored, never the code.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// Only a SHA-256 hash of the session token is stored; the token lives in an httpOnly cookie.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Sliding-window rate limiting (auth now; AI and USSD later). One row per counted request.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------- Organisations and verification (Milestone 3) ----------

enum OrgType {
  SUPPLIER
  BUYER
  LENDER
}

enum OrgStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// Reserved for future subscriptions (PRD 10). Nothing is billed yet.
enum OrgPlan {
  FREE
  PRO
}

enum OrgMemberRole {
  OWNER
  STAFF
}

enum OrgDocumentType {
  REGISTRATION_CERTIFICATE
  LICENCE
}

model Organisation {
  id                 String            @id @default(cuid())
  type               OrgType
  legalName          String
  regNumber          String
  address            String
  districtId         String
  district           District          @relation(fields: [districtId], references: [id])
  contactName        String
  phone              String
  email              String?
  // Agrochemical dealers need a licence (PRD 6.8).
  sellsAgrochemicals Boolean           @default(false)
  status             OrgStatus         @default(DRAFT)
  rejectionReason    String?
  submittedAt        DateTime?
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?             @relation("VerifiedBy", fields: [verifiedById], references: [id])
  plan               OrgPlan           @default(FREE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  members            OrgMember[]
  documents          OrgDocument[]
  supplierListings   SupplierListing[]

  @@index([status, submittedAt])
}

model OrgMember {
  orgId     String
  org       Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // One organisation per user account.
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      OrgMemberRole @default(OWNER)
  createdAt DateTime      @default(now())

  @@id([orgId, userId])
}

// Files live in private storage (lib/adapters/storage), never under /public.
model OrgDocument {
  id          String          @id @default(cuid())
  orgId       String
  org         Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type        OrgDocumentType
  fileKey     String          @unique
  fileName    String
  contentType String
  sizeBytes   Int
  uploadedAt  DateTime        @default(now())

  @@unique([orgId, type])
}

// Who did what, when (PRD 6.9). Written for every admin action.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// ---------- Supplier directory (Milestone 4) ----------

enum SupplierCategory {
  SEEDS
  FERTILISER
  AGROCHEMICALS
  TOOLS
  MACHINERY
  EQUIPMENT_HIRE
  OTHER
}

enum ListingStatus {
  ACTIVE
  // Turned off by the supplier.
  INACTIVE
  // Removed from public view by an admin (PRD 5, A2).
  HIDDEN
}

model SupplierListing {
  id             String           @id @default(cuid())
  orgId          String
  org            Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category       SupplierCategory
  title          String
  description    String
  // Leones in minor units (1 SLE = 100). Null means "ask for price".
  priceMinor     Int?
  unit           String?
  // Districts the supplier serves or delivers to.
  districts      District[]
  // Keys in public media storage (lib/adapters/storage), at most 3.
  photos         String[]
  contactPhone   String
  whatsappNumber String?
  // Paid placement later (PRD 10). Set by admins only, always labelled.
  isSponsored    Boolean          @default(false)
  status         ListingStatus    @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([category, status])
  @@index([orgId])
}

// ---------- Weather and crop guides (Milestone 5) ----------

// One 7-day forecast per district, refreshed at most every 3 hours (PRD 6.4).
model WeatherCache {
  districtId String   @id
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  provider   String
  forecast   Json
  fetchedAt  DateTime
}

enum GuideSection {
  OVERVIEW
  PLANTING_CALENDAR
  SOIL
  FERTILISER
  PESTS
  DISEASES
  HARVEST
  STORAGE
}

// One section of a crop guide (PRD 6.3). Farmers only see published sections.
// Editing a section clears its review and unpublishes it until it is reviewed again.
model CropGuide {
  id           String       @id @default(cuid())
  cropId       String
  crop         Crop         @relation(fields: [cropId], references: [id], onDelete: Cascade)
  section      GuideSection
  // Plain text: blank line between paragraphs, "- " for bullet points.
  content      String
  published    Boolean      @default(false)
  // Starter text written for development, not by an agronomist. Always labelled.
  isSample     Boolean      @default(false)
  reviewedById String?
  reviewedBy   User?        @relation("GuideReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  updatedById  String?
  updatedBy    User?        @relation("GuideUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([cropId, section])
  @@index([published])
}

// ---------- AI farming assistant (Milestone 6) ----------

enum AiRole {
  USER
  ASSISTANT
}

enum AiReviewStatus {
  NONE
  // Waiting in the admin review queue.
  OPEN
  RESOLVED
}

// Conversations are kept for quality review (PRD 6.3; farmers are told above the chat).
model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiRole
  content        String
  // Assistant only: guide sections given to the model, as [{ crop, cropSlug, section }].
  sources        Json           @default("[]")
  // Assistant only: which model (or "safety-rule") produced the answer.
  model          String?
  rating         Int?
  flagged        Boolean        @default(false)
  // "farmer_report" | "safety" | "low_confidence" | "refusal"
  flagReason     String?
  reportNote     String?
  reviewStatus   AiReviewStatus @default(NONE)
  // Reviewer's corrected answer, shown to the farmer under the original.
  correction     String?
  reviewedById   String?
  reviewedBy     User?          @relation("AiReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@index([reviewStatus, createdAt])
}
