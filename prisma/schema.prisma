// SmartFarm Sierra Leone — database schema.
// Milestone 1 holds reference data only; later milestones add their models here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Reference data (Milestone 1) ----------

model District {
  id             String          @id @default(cuid())
  name           String          @unique
  slug           String          @unique
  province       String
  // Forecast point: the district headquarter town (see prisma/data/districts.ts).
  latitude       Float
  longitude      Float
  chiefdoms      Chiefdom[]
  farmerProfiles FarmerProfile[]
  organisations  Organisation[]
}

model Chiefdom {
  id             String          @id @default(cuid())
  name           String
  districtId     String
  district       District        @relation(fields: [districtId], references: [id], onDelete: Cascade)
  farmerProfiles FarmerProfile[]

  @@unique([districtId, name])
  @@index([districtId])
}

model Crop {
  id         String          @id @default(cuid())
  name       String          @unique
  slug       String          @unique
  // Groups crops for display, e.g. vegetables (pepper, okra, tomato).
  group      String
  isPriority Boolean         @default(false)
  farmers    FarmerProfile[]
}

// ---------- Accounts and auth (Milestone 2) ----------

enum Role {
  FARMER
  SUPPLIER
  BUYER
  LENDER
  ADMIN
  AGRONOMIST
}

enum FarmSizeUnit {
  ACRE
  HECTARE
}

model User {
  id            String         @id @default(cuid())
  // E.164, e.g. +23276123456
  phone         String         @unique
  name          String?
  role          Role           @default(FARMER)
  language      String         @default("en")
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?
  farmerProfile FarmerProfile?
  sessions      Session[]
  memberships   OrgMember[]
  verifiedOrgs  Organisation[] @relation("VerifiedBy")
  auditLogs     AuditLog[]
}

model FarmerProfile {
  userId       String       @id
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  districtId   String
  district     District     @relation(fields: [districtId], references: [id])
  chiefdomId   String?
  chiefdom     Chiefdom?    @relation(fields: [chiefdomId], references: [id])
  farmSize     Decimal?     @db.Decimal(10, 2)
  farmSizeUnit FarmSizeUnit @default(ACRE)
  crops        Crop[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([districtId])
}

// One-time sign-in codes. Only an HMAC of the code is stored, never the code.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// Only a SHA-256 hash of the session token is stored; the token lives in an httpOnly cookie.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Sliding-window rate limiting (auth now; AI and USSD later). One row per counted request.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------- Organisations and verification (Milestone 3) ----------

enum OrgType {
  SUPPLIER
  BUYER
  LENDER
}

enum OrgStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// Reserved for future subscriptions (PRD 10). Nothing is billed yet.
enum OrgPlan {
  FREE
  PRO
}

enum OrgMemberRole {
  OWNER
  STAFF
}

enum OrgDocumentType {
  REGISTRATION_CERTIFICATE
  LICENCE
}

model Organisation {
  id                 String        @id @default(cuid())
  type               OrgType
  legalName          String
  regNumber          String
  address            String
  districtId         String
  district           District      @relation(fields: [districtId], references: [id])
  contactName        String
  phone              String
  email              String?
  // Agrochemical dealers need a licence (PRD 6.8).
  sellsAgrochemicals Boolean       @default(false)
  status             OrgStatus     @default(DRAFT)
  rejectionReason    String?
  submittedAt        DateTime?
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?         @relation("VerifiedBy", fields: [verifiedById], references: [id])
  plan               OrgPlan       @default(FREE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  members            OrgMember[]
  documents          OrgDocument[]

  @@index([status, submittedAt])
}

model OrgMember {
  orgId     String
  org       Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // One organisation per user account.
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      OrgMemberRole @default(OWNER)
  createdAt DateTime      @default(now())

  @@id([orgId, userId])
}

// Files live in private storage (lib/adapters/storage), never under /public.
model OrgDocument {
  id          String          @id @default(cuid())
  orgId       String
  org         Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type        OrgDocumentType
  fileKey     String          @unique
  fileName    String
  contentType String
  sizeBytes   Int
  uploadedAt  DateTime        @default(now())

  @@unique([orgId, type])
}

// Who did what, when (PRD 6.9). Written for every admin action.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
