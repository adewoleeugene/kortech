# Copy to .env and fill in. Never commit .env.

# Postgres (local dev). Tests use TEST_DATABASE_URL and reset it on every run.
DATABASE_URL="postgresql://USER@localhost:5432/smartfarm_dev"
TEST_DATABASE_URL="postgresql://USER@localhost:5432/smartfarm_test"

# Error tracking: "console" (default) logs errors as structured JSON.
ERROR_TRACKER="console"

# Public URL of the app, used in the PWA manifest and links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# HMAC key for hashing one-time codes. Generate with: openssl rand -hex 32
OTP_SECRET="change-me"

# SMS provider: "mock" logs messages locally (dev/tests only). Real providers arrive in Milestone 8.
SMS_PROVIDER="mock"
# Optional: the mock provider also appends each message as a JSON line to this file.
SMS_OUTBOX_FILE=".data/sms-outbox.jsonl"

# Private file storage for verification documents. "local" writes under STORAGE_LOCAL_DIR
# (dev only); an S3/R2 implementation can be added behind the same interface.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/private"
# HMAC key for short-lived document links. Generate with: openssl rand -hex 32
STORAGE_SIGNING_SECRET="change-me"
