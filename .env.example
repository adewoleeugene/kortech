# Copy to .env and fill in. Never commit .env.

# Postgres (local dev). Tests use TEST_DATABASE_URL and reset it on every run.
DATABASE_URL="postgresql://USER@localhost:5432/smartfarm_dev"
TEST_DATABASE_URL="postgresql://USER@localhost:5432/smartfarm_test"

# Error tracking: "console" (default) logs errors as structured JSON.
ERROR_TRACKER="console"

# Public URL of the app, used in the PWA manifest and links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
